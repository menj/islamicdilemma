# Development sources stay out of installable theme archives.
/tools export-ignore
/tests export-ignore
/.github export-ignore
/assets/brand/brandmark-square.svg export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/docs/README.md export-ignore
/.claude export-ignore

# Content checksums in content/manifest.json are byte-exact: never convert line endings.
/content/** -text
