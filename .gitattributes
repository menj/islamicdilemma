# Development sources stay out of installable theme archives.
/tools export-ignore
/tests export-ignore
/design export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/docs/theme export-ignore
/docs/README.md export-ignore
/docs/CLAUDE.md export-ignore
/docs/FARUQI.md export-ignore
/docs/SEO.md export-ignore
/docs/anti-ai-writing-style.md export-ignore

# Content checksums in content/manifest.json are byte-exact: never convert line endings.
/content/** -text
/FARUQI.md export-ignore
/CLAUDE.md export-ignore
