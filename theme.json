		"custom": {
			"radius": {
				"sm": "12px",
				"md": "20px",
				"lg": "28px",
				"pill": "999px"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.1rem",
			"padding": {
				"left": "max(16px, env(safe-area-inset-left, 0px))",
				"right": "max(16px, env(safe-area-inset-right, 0px))",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--marcellus)",
					"fontWeight": "400",
					"lineHeight": "1.18",
					"letterSpacing": "0"
				},
				"color": {
					"text": "inherit"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2.1rem, 4.6vw, 3.4rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--gold-text)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--gold)",
					"text": "#16202C"
				},
				"border": {
					"radius": "999px",
					"width": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
					"fontSize": "0.78rem",
					"fontWeight": "600",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top": "13px",
						"bottom": "13px",
						"left": "22px",
						"right": "22px"
					}
				},
				":hover": {
					"color": {
						"background": "#D3AD72",
						"text": "#16202C"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--gold)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "0.76rem"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.65"
				}
			},
			"core/post-content": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sabon)",
					"fontSize": "1.09rem",
					"lineHeight": "1.8"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sabon)",
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.72rem",
					"fontWeight": "600",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
