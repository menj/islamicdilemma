			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.3rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.3rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.45rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "2.4rem",
					"fluid": {
						"min": "1.8rem",
						"max": "2.4rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4.2rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.2rem"
					}
				}
			]
