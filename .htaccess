# Islamic Dilemma theme folder. Written by the Islamic Dilemma theme.
#
# Apache reads this file on every request into the theme folder, before
# WordPress starts, so the development files an FTP upload of a working
# copy brings along are refused from the moment they arrive. Nothing here
# touches the styles, scripts, fonts or images the pages load.

# Every file and folder whose name begins with a dot: .git, .github,
# .gitignore, .claude, .env and the like. .well-known stays open.
<IfModule mod_alias.c>
RedirectMatch 403 /\.(?!well-known(/|$))[^/]+(/|$)
# No PHP file in the theme serves a page of its own.
RedirectMatch 403 \.php(/|$)
</IfModule>
<FilesMatch "^\.">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>

# The tests and the build and verification tools at the top of the theme
# folder. The pattern is the path below this folder, whatever its address.
# tests/ and tools/ also carry an .htaccess of their own.
<IfModule mod_rewrite.c>
RewriteEngine On
# Keep the site's own rules for requests into this folder.
RewriteOptions Inherit
# Dot entries too, for a server without mod_alias (FilesMatch above
# matches a file's own name, not a dot folder such as .git/ above it).
RewriteRule (^|/)\.(?!well-known(/|$)) - [F]
RewriteRule ^(tests|tools)(/|$) - [F]
</IfModule>
