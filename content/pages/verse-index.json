 "title": "Verse index",
 "excerpt": "Every Qur’an and Bible verse cited on this site, grouped by sūra and by book, with links to the pages that discuss it.",
 "status": "publish",
 "content": "<!-- wp:columns {\"align\":\"wide\",\"className\":\"article-grid\"} -->\n<div class=\"wp-block-columns alignwide article-grid\"><!-- wp:column {\"width\":\"64%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:64%\"><!-- wp:paragraph {\"className\":\"is-style-lead\"} -->\n<p class=\"is-style-lead\">Look up any verse and see every page of this site that discusses it. The index is built from the pages themselves, so it is always current: the Qur’an is grouped by sūra, and the Bible by book in its usual order. Type a reference or a page title to filter.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:shortcode -->\n[islamicdilemma_verse_index]\n<!-- /wp:shortcode --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:group {\"className\":\"sidebar\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group sidebar\"><!-- wp:shortcode -->\n[islamicdilemma_toc]\n<!-- /wp:shortcode -->\n\n<!-- wp:group {\"className\":\"is-style-side-box\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-side-box\"><!-- wp:heading {\"className\":\"side-title\"} -->\n<h2 class=\"wp-block-heading side-title\">Margin notes</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"gloss\"} -->\n<p class=\"gloss\"><strong>How it works</strong> The index reads the references on every page and updates when a page is saved.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"gloss\"} -->\n<p class=\"gloss\"><strong>References</strong> “Q 5:48” means sūra 5, verse 48.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"is-style-side-box\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group is-style-side-box\"><!-- wp:heading {\"className\":\"side-title\"} -->\n<h2 class=\"wp-block-heading side-title\">Read next</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"gloss\"} -->\n<p class=\"gloss\"><a href=\"{{home_url}}/glossary-and-reading-list/\">Glossary and reading list</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"gloss\"} -->\n<p class=\"gloss\"><a href=\"{{home_url}}/site-map/\">Site map</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->",
